# ============================================================
#  Copia este archivo como ".env" y llena los valores.
#  NUNCA subas el archivo .env a GitHub.
# ============================================================

PORT=3000

# Supabase → Project Settings → API (o "Data API" / "API Keys")
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Llave pública: "anon" (o "publishable", empieza por sb_publishable_)
SUPABASE_ANON_KEY=pega-aqui-la-llave-publica
# Llave SECRETA: "service_role" (o "secret", empieza por sb_secret_).
# Solo se usa en el servidor (borrar cuentas y enviar los recordatorios). Nunca la pongas en el frontend.
SUPABASE_SERVICE_ROLE_KEY=pega-aqui-la-llave-secreta

# Dirección pública de la app (para los enlaces de los correos de confirmación y recuperación)
SITE_URL=http://localhost:3000

# Pon "production" cuando la publiques (cookies solo por HTTPS)
NODE_ENV=development

# ---------- Recordatorios (notificaciones push) ----------
# Genera el par de llaves con:  npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACTO=mailto:tu-correo@ejemplo.com
# Clave larga y aleatoria. Vercel la manda sola al llamar al envío diario (vercel.json → crons).
CRON_SECRET=

# ---------- Asistente con IA (Claude) ----------
# Crea la clave en https://console.anthropic.com → API Keys. Sin clave, el asistente usa respuestas de respaldo.
ANTHROPIC_API_KEY=
# Modelo (opcional). Por defecto: claude-haiku-4-5-20251001 (rápido y económico)
IA_MODELO=
# Preguntas por usuario al día (opcional, por defecto 20)
IA_LIMITE_DIARIO=
