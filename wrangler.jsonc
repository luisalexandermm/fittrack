{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fittrack",
  "main": "worker.js",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  }
}
